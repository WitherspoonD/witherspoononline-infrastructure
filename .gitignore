# Terraform state — NEVER commit these
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Terraform plan output
tfplan
*.tfplan

# Lambda build artifact — generated by Terraform
modules/lambda/lambda_function.zip

# Secrets — values are in tfvars but .tfvars files with real creds stay local
# terraform.tfvars is committed (it has defaults), but override files are not
*.auto.tfvars
override.tf
override.tf.json

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
